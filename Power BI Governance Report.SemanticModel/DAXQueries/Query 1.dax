// DAX query generated by Fabric Copilot with "top 1 function which has most user in table 'public v_dim_pbi_copilot_list'. keep it simple to be created a measure"
DEFINE
  MEASURE 'public v_dim_pbi_copilot_list'[Top Function User Count] =
  VAR _FunctionUsers = SUMMARIZE(
    'public v_dim_pbi_copilot_list',
    'public v_dim_pbi_copilot_list'[Function],
    "User Count", COUNT('public v_dim_pbi_copilot_list'[itcode])
  )
  // Get the function with the most users
  VAR _TopFunction = TOPN(
    1,
    _FunctionUsers,
    [User Count],
    DESC
  )
  RETURN MAXX(_TopFunction, [User Count])
