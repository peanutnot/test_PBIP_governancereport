table Calendar
	lineageTag: 0ab4c756-bc63-445c-aa5b-032db0432fa2

	measure #sigma = "+"
		lineageTag: a600efa4-01c4-4b86-a3f4-3801a9b386e0

	measure PreTotalUsers =
			
			VAR SELECTMONT =[SelectedMonth]
			VAR LASTYEAR = [LastYearMonth]
			VAR RESULT = calculate(DISTINCTCOUNT('public v_fact_pbiuniqueuser'[itcode]),'public v_fact_pbiuniqueuser'[activitymonth]< SELECTMONT && 'public v_fact_pbiuniqueuser'[activitymonth]>= LASTYEAR)
			RETURN RESULT
		formatString: 0
		lineageTag: b44a64bb-57be-4756-bbc1-3253e5fe9124

	column Year
		formatString: 0
		lineageTag: eb461abe-7b6c-4027-8210-cc7dc56396a7
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column MonthNo
		lineageTag: 0930290e-9cfe-44a9-99cc-5bf7627ad298
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = Automatic

