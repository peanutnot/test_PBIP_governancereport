	column datasetcreationmonth
		dataType: string
		lineageTag: 4917ab38-eac9-4f97-bc54-bf50003f38f5
		summarizeBy: none
		sourceColumn: datasetcreationmonth

		annotation SummarizationSetBy = Automatic

	column last_log =
			
			VAR datasetid = [datasetid]
			VAR RESULT = CALCULATE(MAX('public v_fact_pbiactivity'[activitydate]), 'public v_fact_pbiactivity'[datasetid] = datasetid )
			RETURN RESULT
		lineageTag: 1c868a20-e7ee-41a6-ad2f-b49cc077d870
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column existing_duration = ```
			
			VAR datasetid = [datasetid]
			VAR createmonth = [datasetcreationmonth]
			VAR RESULT = SWITCH(TRUE(),
			createmonth>=[3_months_before], "Active",
			createmonth<[12_months_before],  "> 12 months", 
			createmonth<[6_months_before], "> 6 months", 
			createmonth<[3_months_before], "> 3 months", 
			"Active")
			return RESULT
			```
		lineageTag: 27ba1143-7782-40f8-97a0-f210514f22df
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column inactive_duration = ```
			
			VAR datasetid = [datasetid]
			VAR last_log = [last_log]
			VAR reportcreation = CALCULATE(SELECTEDVALUE('public v_dim_pbireport'[reportcreationmonth]),  'public v_dim_pbireport'[reportid] = datasetid)
			VAR RESULT = SWITCH(TRUE(),
			reportcreation>=[3_months_before], "Active",
			last_log<[12_months_before],  "> 12 months/never accessed", 
			last_log<[6_months_before], "> 6 months", 
			last_log<[3_months_before], "> 3 months", 
			"Active")
			return RESULT
			```
		lineageTag: 0049bac2-e4ed-40a2-abd6-b1846b39d8b4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

