	measure 'Daily Active User' = ```
			VAR SELECTMONT = [SelectedMonth]
			VAR USERCOUNT = calculate(COUNT('public v_fact_pbiuniqueuser'[itcode]),'public v_fact_pbiuniqueuser'[activitymonth]= SELECTMONT)
			VAR DAYCOUNT = calculate(DISTINCTCOUNT('Calendar'[Date]),'Calendar'[YearMonthNo]= SELECTMONT)
			// VAR DAYCOUNT = calculate(DISTINCTCOUNT('public v_fact_pbiuniqueuser'[activitydate]),'public v_fact_pbiuniqueuser'[activitymonth]= SELECTMONT)
			// VAR RESULT = ROUND(USERCOUNT/30,0)
			VAR RESULT = USERCOUNT/DAYCOUNT
			RETURN RESULT
			
