table MeasureTable
	lineageTag: cafdf9b1-ad9d-46a4-932e-5d81d0cb22b3

	measure 'Viewed Times' = ```
			
			VAR SELECTMONT = [SelectedMonth]
			VAR RESULT = calculate(COUNT('public v_fact_pbiactivity'[activity]),'public v_fact_pbiactivity'[activitymonth] = SELECTMONT  && 'public v_fact_pbiactivity'[activity]= "ViewReport" )
			RETURN RESULT
			
			```
		formatString: 0
		displayFolder: Views
		lineageTag: 3abb124f-f72d-461a-a41d-930f8ae0e022

	measure Reports =
			
			VAR SELECTMONT = [SelectedMonth]
			VAR RESULT = calculate(DISTINCTCOUNT('public v_dim_pbireport'[reportid]),'public v_dim_pbireport'[reportcreationmonth]<= SELECTMONT&& OR ('public v_dim_pbireport'[reportdeletemonth]= blank() ,'public v_dim_pbireport'[reportdeletemonth]> SELECTMONT))
			RETURN RESULT
		formatString: #,0
		displayFolder: Reports
		lineageTag: 82ed3f2f-3016-41ba-a30c-182d0e744128

		changedProperty = FormatString

	measure SelectedMonth = MAX('Calendar'[YearMonthNo])
