	column 'manager2 name' =
			
			VAR temp = LOOKUPVALUE('public dim_user_structure'[name],'public dim_user_structure'[userid],'public v_dim_pbireport'[manager 2])
			VAR managersname = if (
			    temp = BLANK(),
			    "Unknown",
			    temp)
			RETURN managersname
		lineageTag: 94727fb7-af33-4b91-9b80-0248c6ee37ab
		summarizeBy: none

