	column Replace_ReportOwner =
			
			VAR workspaceowner = LOOKUPVALUE('public v_dim_pbiworkspaces'[WorkspaceOwnerID],'public v_dim_pbiworkspaces'[workspaceid],'public v_dim_pbireport'[workspaceid])
