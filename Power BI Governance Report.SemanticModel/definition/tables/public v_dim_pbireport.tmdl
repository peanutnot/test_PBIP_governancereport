	column last_view =
			
			VAR reportid = [reportid]
			VAR RESULT = CALCULATE(MAX('public v_fact_pbiactivity'[activitydate]), 'public v_fact_pbiactivity'[reportid] = reportid,'public v_fact_pbiactivity'[activity] = "ViewReport" )
			RETURN RESULT
		lineageTag: 5b9c8e2c-b3da-4c72-94fc-01caa2ce343f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column inactive_duration = ```
			
			VAR reportid = [reportid]
			VAR last_view = [last_view]
			VAR reportcreation = CALCULATE(SELECTEDVALUE('public v_dim_pbireport'[reportcreationmonth]),  'public v_dim_pbireport'[reportid] = reportid)
			VAR RESULT = SWITCH(TRUE(),
			reportcreation>=[3_months_before], "Active",
			last_view<[12_months_before],  "> 12 months/never accessed", 
			last_view<[6_months_before], "> 6 months", 
			last_view<[3_months_before], "> 3 months", 
			"Active")
			return RESULT
			```
		lineageTag: a91b2a53-9fd2-4ceb-b41d-c1920aeb0ba0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column existing_duration = ```
			
			VAR reportid = [reportid]
			VAR createmonth = [reportcreationmonth]
			VAR RESULT = SWITCH(TRUE(),
			createmonth>=[3_months_before], "Active",
			createmonth<[12_months_before],  "> 12 months", 
			createmonth<[6_months_before], "> 6 months", 
			createmonth<[3_months_before], "> 3 months", 
			"Active")
			return RESULT
			```
		lineageTag: 87565e3c-655d-4c30-b119-27379d190628
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

