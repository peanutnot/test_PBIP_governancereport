	column last_visit =
			
			VAR reportid = [reportid]
			VAR emailaddress = lower([emailaddress])
			VAR RESULT = CALCULATE(MAX('public v_fact_pbiactivity'[activitydate]), 'public v_fact_pbiactivity'[reportid] = reportid , lower('public v_fact_pbiactivity'[userid]) =emailaddress )
			RETURN RESULT
		lineageTag: 5acf8d0e-b69a-48cd-b6da-9ed226eea08a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column inactive_duration = ```
			
			VAR reportid = [reportid]
			VAR last_visit = [last_visit]
			VAR reportcreation = CALCULATE(SELECTEDVALUE('public v_dim_pbireport'[reportcreationmonth]),  'public v_dim_pbireport'[reportid] = reportid)
			VAR RESULT = SWITCH(TRUE(),
			reportcreation>=[3_months_before], "Active",
			coalesce(last_visit,reportcreation) <[12_months_before],  "> 12 months/never accessed", 
			coalesce(last_visit,reportcreation)<[6_months_before], "> 6 months", 
			coalesce(last_visit,reportcreation)<[3_months_before], "> 3 months", 
			"Active")
			return RESULT
			```
		lineageTag: 7ea60e44-9cd2-42ab-a338-5f698bbd53bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

